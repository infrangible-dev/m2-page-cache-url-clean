{
    "name": "infrangible/m2-page-cache-url-clean",
    "description": "Adds a field to the Cache Management page to remove a single URL from the full page cache, without flushing the whole cache.",
    "type": "magento2-module",
    "version": "3.0.0",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Performance",
        "Admin tools",
        "remove one URL from the full page cache",
        "clean cache by URL",
        "purge single page"
    ],
    "homepage": "https://www.infrangible.dev/modules/page-cache-url-clean",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.3",
        "infrangible/m2-foundation": "~3.0.2",
        "magento/framework": "~103.0.6",
        "magento/module-backend": "~102.0.0",
        "magento/module-page-cache": "~100.4.0",
        "magento/zend-cache": "~1.16.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\PageCacheUrlClean\\": "src"
        }
    }
}
