use Infrangible\PageCacheUrlClean\Block\Clean;
use Magento\Framework\Escaper;

/** @var Clean $block */
/** @var Escaper $escaper */
?>
<div class="additional-cache-management page-cache-url-clean">
    <h2>
        <span><?= $escaper->escapeHtml(__('Page Cache Url Clean')) ?></span>
    </h2>
    <form action="<?= $escaper->escapeUrl($block->getCleanUrl()) ?>" method="post">
        <input name="form_key" type="hidden" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>">
        <label>
            <input type="text" name="url">
        </label>
        <button type="submit"><?= $escaper->escapeHtml(__('Clean url')) ?></button>
    </form>
</div>
